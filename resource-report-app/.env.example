# ==============================================================================
# Microsoft SQL Server Configuration
# ==============================================================================

# Option 1: Standard Connection Settings
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=ResourceUtilizationDB

# Windows Authentication (set to "yes" to use current Windows user credentials)
SQL_SERVER_TRUSTED_CONNECTION=yes

# SQL Server Authentication (set if SQL_SERVER_TRUSTED_CONNECTION=no)
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=

# Optional: Specific ODBC Driver (leave blank for automatic best-driver detection)
# Drivers detected automatically in order: "ODBC Driver 18 for SQL Server", "ODBC Driver 17 for SQL Server", "SQL Server"
SQL_SERVER_DRIVER=

# Encryption & Certificate Trust (default 'no' for TrustServerCertificate when connecting to local/dev servers)
SQL_SERVER_TRUST_CERTIFICATE=yes
SQL_SERVER_ENCRYPT=no

# Option 2: Direct Connection String Override (takes precedence if provided)
# SQL_SERVER_CONN_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=ResourceUtilizationDB;Trusted_Connection=yes;TrustServerCertificate=yes;

# ==============================================================================
# Google Gemini AI Configuration (for Executive Analysis & Governance Insights)
# ==============================================================================
# Get a key at https://aistudio.google.com/apikey - leave blank to use the
# deterministic rule-based insights engine instead of a live LLM call.
GEMINI_API_KEY=
# "gemini-flash-lite-latest" is a rolling alias Google keeps pointed at a
# current lite-tier model, so it won't silently 404 the way a pinned dated
# model eventually will, and has more capacity headroom than the full
# "gemini-flash-latest" alias.
LLM_MODEL=gemini-flash-lite-latest
